+  ReceptionSupport.start(state);
+  paywall = ReceptionStorePaywall.start(
+    () => navigatorKey.currentState!.push(
+      MaterialPageRoute<void>(
+        fullscreenDialog: true,
+        builder: (_) => const PaywallScreen(),
+      ),
+    ),
+  );
   runApp(WalkthroughApp(state: state));
 }
 
