 import 'package:flutter/material.dart';
 import 'package:flutter_localizations/flutter_localizations.dart';
+import 'package:reception_flutter/testing.dart';
 
 import 'app_state.dart';
+import 'reception_store_paywall.dart';
+import 'reception_support.dart';
 import 'screens/home_screen.dart';
+import 'screens/paywall_screen.dart';
 import 'strings.dart';
 import 'theme.dart';
 
 final navigatorKey = GlobalKey<NavigatorState>();
 
+/// Offers the paywall in the support chat.
+late ReceptionStorePaywall paywall;
+
 Future<void> main() async {
   WidgetsFlutterBinding.ensureInitialized();
   final state = await AppState.load();
+  // Reception support chat. Docs for changes: http://localhost:3123/llms.txt
+  // Walkthrough deviation: the local service instead of
+  // Reception.configure(appId: ...), which talks to the hosted service.
+  await configureReceptionForTesting(
+    appId: '<APP_ID>',
+    serviceUrl: Uri.parse('http://localhost:3123'),
