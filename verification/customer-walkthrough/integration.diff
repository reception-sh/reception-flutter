diff --git a/lib/reception_store_paywall.dart b/lib/reception_store_paywall.dart
new file mode 100644
index 0000000..31c72b9
--- /dev/null
+++ b/lib/reception_store_paywall.dart
@@ -0,0 +1,143 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:reception_flutter/reception_flutter.dart';
+
+/// Offers a paywall screen built in your Flutter code as a Reception paywall
+/// card.
+///
+/// Start once in `main()` after `Reception.configure`, passing your function that shows the screen and
+/// completes when it closes, and keep the returned helper:
+///
+///     var paywall = ReceptionStorePaywall.start(presentYourPaywall);
+///
+/// The card stays available until the customer owns every product in
+/// `_products`. Call [stop] before changing accounts, then start again for the
+/// new account.
+final class ReceptionStorePaywall {
+  ReceptionStorePaywall._(this._present, this._closesChat);
+
+  // Replace with the products sold by your existing screen. Consumables never
+  // count as owned.
+  static const _products = [
+    (id: 'walkthrough_pro_monthly', consumable: false),
+    (id: 'walkthrough_pro_yearly', consumable: false),
+  ];
+
+  final Future<void> Function() _present;
+  final bool _closesChat;
+  AppLifecycleListener? _lifecycle;
+  var _active = false;
+  var _revision = 0;
+
+  /// Starts on iOS; on Android and web Reception shows no cards, so this does
+  /// nothing there. Pass `closesChatSheet: false` when the chat is a
+  /// `ReceptionChatView` inside your own route.
+  static ReceptionStorePaywall start(
+    Future<void> Function() present, {
+    bool closesChatSheet = true,
+  }) {
+    final helper = ReceptionStorePaywall._(present, closesChatSheet);
+    if (kIsWeb || defaultTargetPlatform != TargetPlatform.iOS) return helper;
+    helper._active = true;
+    Reception.paywallAvailability = helper._isAvailable;
+    Reception.onPaywall = helper._open;
+    Reception.paywalls = [
+      ReceptionPaywall(
+        id: 'plans',
+        title: 'Plans',
+        source: 'app',
+        products: [
+          for (final product in _products)
+            ReceptionPaywallProduct(id: product.id),
+        ],
+      ),
+    ];
+    helper._lifecycle = AppLifecycleListener(onResume: helper._refresh);
+    helper._refresh();
+    return helper;
+  }
+
+  /// Removes the listeners, and the card while this helper still owns it.
+  void stop() {
+    if (!_active) return;
+    _active = false;
+    _lifecycle?.dispose();
+    if (Reception.paywallAvailability == _isAvailable) {
+      Reception.paywallAvailability = null;
+    }
+    if (Reception.onPaywall == _open) {
+      Reception.onPaywall = null;
+      Reception.paywalls = const [];
+    }
+  }
+
+  // The app has no store library yet, so it owns nothing and sends no
+  // subscription details; the app's own plan goes out with its user details.
+  // When purchases ship, read the store's entitlements here and in
+  // _isAvailable, and call _update from its purchase-change listener.
+  static Future<Set<String>> _ownedProductIds() async => const {};
+
+  void _update() {
+    if (!_active) return;
+    _revision += 1;
+    unawaited(Reception.refreshPaywalls(invalidate: true).catchError(_failed));
+  }
+
+  void _refresh() => unawaited(_reload().catchError(_failed));
+
+  Future<void> _reload() async {
+    final request = ++_revision;
+    await _ownedProductIds();
+    if (_active && request == _revision) _update();
+  }
+
+  Future<bool> _isAvailable(String id) async {
+    if (id != 'plans') return false;
+    final owned = await _ownedProductIds();
+    return _active &&
+        _products.any(
+          (product) => product.consumable || !owned.contains(product.id),
+        );
+  }
+
+  void _open(String id) {
+    if (!_active || id != 'plans') return;
+    unawaited(_presentPaywall().catchError(_failed));
+  }
+
+  /// Your screen renders in Flutter, below Reception's native chat sheet, so
+  /// the sheet closes first and opens again when your screen closes.
+  Future<void> _presentPaywall() async {
+    final reopen = _closesChat && Reception.isChatOpen.value;
+    if (reopen) {
+      await Reception.closeChat();
+      await _chatClosed();
+      if (!_active) return;
+    }
+    await _present();
+    if (!_active) return;
+    if (reopen) await Reception.openChat();
+    if (!_active) return;
+    await _reload();
+  }
+
+  /// Completes once the chat has closed, or after two seconds if it stays open.
+  static Future<void> _chatClosed() {
+    final open = Reception.isChatOpen;
+    if (!open.value) return Future.value();
+    final closed = Completer<void>();
+    void listener() {
+      if (!open.value && !closed.isCompleted) closed.complete();
+    }
+
+    open.addListener(listener);
+    return closed.future
+        .timeout(const Duration(seconds: 2), onTimeout: () {})
+        .whenComplete(() => open.removeListener(listener));
+  }
+
+  static void _failed(Object error) =>
+      debugPrint('Reception paywall could not refresh or present: $error');
+}
diff --git a/lib/reception_support.dart b/lib/reception_support.dart
new file mode 100644
index 0000000..0b4d07c
--- /dev/null
+++ b/lib/reception_support.dart
@@ -0,0 +1,99 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:reception_flutter/reception_flutter.dart';
+
+import 'app_state.dart';
+import 'theme.dart';
+
+/// Keeps Reception's look, language, identity and user details in step with
+/// the app's settings and the signed-in user.
+class ReceptionSupport {
+  ReceptionSupport._(this._state);
+
+  final AppState _state;
+  ThemeMode? _themeMode;
+  String? _languageCode;
+  String? _userName;
+
+  /// Applies the current state and follows later changes.
+  static void start(AppState state) {
+    final support = ReceptionSupport._(state)
+      .._userName = state.userName
+      .._applyLook(force: true)
+      .._identify();
+    state.addListener(support._changed);
+  }
+
+  void _changed() {
+    _applyLook();
+    final name = _state.userName;
+    if (name == _userName) return;
+    final signedOut = _userName != null && name == null;
+    _userName = name;
+    unawaited(_switchUser(signedOut));
+  }
+
+  Future<void> _switchUser(bool signedOut) async {
+    // Sign-out ends the signed-in session: start a new, empty chat.
+    if (signedOut) await Reception.logout();
+    await _identify();
+  }
+
+  void _applyLook({bool force = false}) {
+    if (force || _themeMode != _state.themeMode) {
+      _themeMode = _state.themeMode;
+      Reception.appearance = _appearance(_state.themeMode);
+    }
+    if (force || _languageCode != _state.languageCode) {
+      _languageCode = _state.languageCode;
+      Reception.languageOverride = _state.languageCode;
+    }
+  }
+
+  static ReceptionAppearance _appearance(ThemeMode mode) {
+    final light = lightTheme.colorScheme;
+    final dark = darkTheme.colorScheme;
+    return ReceptionAppearance(
+      accentColor: ReceptionColor.adaptiveOf(
+        light: light.primary,
+        dark: dark.primary,
+      ),
+      onAccentColor: ReceptionColor.adaptiveOf(
+        light: light.onPrimary,
+        dark: dark.onPrimary,
+      ),
+      chatBackground: ReceptionColor.adaptiveOf(
+        light: light.surface,
+        dark: dark.surface,
+      ),
+      incomingBackground: ReceptionColor.adaptiveOf(
+        light: light.surfaceContainerHighest,
+        dark: dark.surfaceContainerHighest,
+      ),
+      incomingForeground: ReceptionColor.adaptiveOf(
+        light: light.onSurface,
+        dark: dark.onSurface,
+      ),
+      preferredColorScheme: switch (mode) {
+        ThemeMode.light => ReceptionColorScheme.light,
+        ThemeMode.dark => ReceptionColorScheme.dark,
+        ThemeMode.system => null,
+      },
+    );
+  }
+
+  /// Sends the entered name and the chosen user details: plan and sign-up date.
+  Future<void> _identify() async {
+    final name = _state.userName;
+    if (name != null) {
+      await Reception.identify(ReceptionIdentity.user(name: name));
+    }
+    final signUpDate = _state.signUpDate;
+    await Reception.setMetadata({
+      'plan': _state.plan,
+      if (signUpDate != null)
+        'sign_up_date': signUpDate.toIso8601String().split('T').first,
+    });
+  }
+}
diff --git a/lib/widgets/support_badge.dart b/lib/widgets/support_badge.dart
new file mode 100644
index 0000000..f305d73
--- /dev/null
+++ b/lib/widgets/support_badge.dart
@@ -0,0 +1,50 @@
+import 'package:flutter/cupertino.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:reception_flutter/reception_flutter.dart';
+
+/// Reception's chat exists only on iOS.
+final supportsReception =
+    !kIsWeb && defaultTargetPlatform == TargetPlatform.iOS;
+
+/// Rebuilds with Reception's live unread count.
+class UnreadCountBuilder extends StatelessWidget {
+  const UnreadCountBuilder({super.key, required this.builder});
+
+  final Widget Function(BuildContext context, int unread) builder;
+
+  @override
+  Widget build(BuildContext context) => ValueListenableBuilder<int>(
+    valueListenable: Reception.unreadCount,
+    builder: (context, unread, _) => builder(context, unread),
+  );
+}
+
+/// The iOS unread badge: a system red capsule with the white count.
+class UnreadCapsule extends StatelessWidget {
+  const UnreadCapsule({super.key, required this.count});
+
+  final int count;
+
+  @override
+  Widget build(BuildContext context) => Container(
+    constraints: const BoxConstraints(minWidth: 20, minHeight: 20),
+    padding: const EdgeInsets.symmetric(horizontal: 6),
+    decoration: ShapeDecoration(
+      color: CupertinoDynamicColor.resolve(CupertinoColors.systemRed, context),
+      shape: const StadiumBorder(),
+    ),
+    child: Center(
+      widthFactor: 1,
+      heightFactor: 1,
+      child: Text(
+        '$count',
+        style: const TextStyle(
+          color: Colors.white,
+          fontSize: 13,
+          fontWeight: FontWeight.w600,
+        ),
+      ),
+    ),
+  );
+}
