<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds talk to the local backend over plain HTTP (10.0.2.2 is the host machine from the emulator). -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">
        <!-- Cached-engine hosts that rotation recreates (verification/android.md "Fix round 1"). -->
        <activity
            android:name=".CachedEngineActivity"
            android:exported="true"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CachedEngineFragmentActivity"
            android:exported="true"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
